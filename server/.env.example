PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/barware-store?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
# Public base URL of this API, used to build absolute upload URLs (defaults to the request host)
SERVER_URL=http://localhost:5000
ADMIN_EMAIL=admin@barware.test
ADMIN_PASSWORD=Admin@12345
# Optional: when all three are set, uploads go to Cloudinary instead of ./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# "none" when the client and API are on different domains (default in production); "lax" for same-site
COOKIE_SAMESITE=
# Max API requests per IP per 15 minutes (default 3000)
API_RATE_LIMIT=
# Transactional email (optional, free tiers): set ONE of these keys.
# Brevo: 300 emails/day free - https://www.brevo.com
# Resend: 3,000 emails/month free - https://resend.com
# When neither is set, emails are skipped and only logged.
BREVO_API_KEY=
RESEND_API_KEY=
# Sender address/name (must be verified with your email provider)
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME=VYRNT
# UPI QR payments: customers scan a QR and pay you directly; an admin verifies each payment.
# Set your real UPI ID (e.g. yourname@okhdfcbank). Leave blank to hide UPI at checkout.
UPI_ID=
UPI_PAYEE_NAME=VYRNT

