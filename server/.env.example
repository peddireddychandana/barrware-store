PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/barware-store?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
# Public base URL of this API, used to build absolute upload URLs (defaults to the request host)
SERVER_URL=http://localhost:5000
ADMIN_EMAIL=admin@barware.test
ADMIN_PASSWORD=Admin@12345
# Optional: when all three are set, uploads go to Cloudinary instead of ./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# "none" when the client and API are on different domains (default in production); "lax" for same-site
COOKIE_SAMESITE=
# Max API requests per IP per 15 minutes (default 3000)
API_RATE_LIMIT=
# AI Product Assistant: create a free Gemini API key at https://aistudio.google.com/apikey
# Server-side only. When empty, the chat endpoint returns a friendly "not configured" message.
GEMINI_API_KEY=
# Optional model override (default: gemini-3.8-flash, available on the free tier)
GEMINI_MODEL=
# Transactional email (optional, free tiers): set ONE of these keys.
# Brevo: 300 emails/day free - https://www.brevo.com
# Resend: 3,000 emails/month free - https://resend.com
# When neither is set, emails are skipped and only logged.
BREVO_API_KEY=
RESEND_API_KEY=
# Sender address/name (must be verified with your email provider)
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME=VYRNT
# UPI QR payments: customers scan a QR and pay you directly; an admin verifies each payment.
# Scanner UPI ID used for QR payments at checkout. Defaults to 9398278894@ibl.
UPI_ID=9398278894@ibl
UPI_PAYEE_NAME=VYRNT
# Extra origins (comma separated) accepted by CORS/CSRF in addition to CLIENT_URL
CORS_ORIGINS=
# Mobile OTP login
# Minutes before an OTP expires (default 10)
OTP_TTL_MINUTES=10
# Seconds before a new OTP can be requested (default 60)
OTP_RESEND_COOLDOWN_SECONDS=60
# Wrong attempts allowed per OTP (default 5)
OTP_MAX_ATTEMPTS=5
# SMS provider for OTP delivery. Set to "twilio" and fill the keys below.
# When empty (and not production), codes are logged to the server console only.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

